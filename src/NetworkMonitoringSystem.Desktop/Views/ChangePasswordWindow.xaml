<Window x:Class="NetworkMonitoringSystem.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NetworkMonitoringSystem.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:ChangePasswordViewModel}"
        Title="Zmena hesla" Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <Label Content="_Súčasné heslo" Target="{Binding ElementName=CurrentPasswordBox}" Padding="0,0,0,4" />
        <PasswordBox x:Name="CurrentPasswordBox" Padding="4" MaxLength="256" />

        <Label Content="_Nové heslo (aspoň 8 znakov)" Target="{Binding ElementName=NewPasswordBox}" Padding="0,12,0,4" />
        <PasswordBox x:Name="NewPasswordBox" Padding="4" MaxLength="256" />

        <Label Content="_Zopakujte nové heslo" Target="{Binding ElementName=RepeatedPasswordBox}" Padding="0,12,0,4" />
        <PasswordBox x:Name="RepeatedPasswordBox" Padding="4" MaxLength="256" />

        <TextBlock Text="Po zmene hesla budete všade odhlásený a prihlásite sa novým heslom."
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock Text="{Binding Message}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="32" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Zrušiť" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="Zmeniť heslo" IsDefault="True" Padding="16,6" Click="OnChangeClick" />
        </StackPanel>
    </StackPanel>
</Window>
