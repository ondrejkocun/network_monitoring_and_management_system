<Window x:Class="NetworkMonitoringSystem.Desktop.Views.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=InputBox}">
    <StackPanel Margin="20">
        <Label x:Name="PromptLabel" Target="{Binding ElementName=InputBox}" Padding="0,0,0,4" />
        <TextBox x:Name="InputBox" Padding="4" TextChanged="OnTextChanged" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Zrušiť" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Content="Uložiť" IsDefault="True" Padding="16,6" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
