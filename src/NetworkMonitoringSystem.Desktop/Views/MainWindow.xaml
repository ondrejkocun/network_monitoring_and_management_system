<Window x:Class="NetworkMonitoringSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NetworkMonitoringSystem.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Title="{Binding Title}" Height="560" Width="900" MinHeight="400" MinWidth="700">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Obnoviť" Padding="12,4" Command="{Binding RefreshCommand}" />
            <Button DockPanel.Dock="Right" Content="Odstrániť vybrané" Padding="12,4" Margin="0,0,8,0"
                    Command="{Binding RemoveDeviceCommand}" />
            <TextBlock Text="Zariadenia" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Adresa" Binding="{Binding Address}" Width="2*" />
                <DataGridTextColumn Header="Sledovanie" Binding="{Binding ModeText}" Width="*" />
                <DataGridTextColumn Header="Stav" Binding="{Binding StatusText}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="Gray" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="Online">
                                    <Setter Property="Foreground" Value="#1B7F3B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Offline">
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Naposledy videné" Binding="{Binding LastSeenText}" Width="2*" />
                <DataGridTextColumn Header="Operačný systém" Binding="{Binding OperatingSystem}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2" Header="Pridať zariadenie bez agenta" Margin="0,10,0,0" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Názov:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="200" VerticalContentAlignment="Center"
                         Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="IP adresa:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Width="160" VerticalContentAlignment="Center"
                         Text="{Binding NewDeviceIpAddress, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Pridať" Padding="12,4" Margin="16,0,0,0" Command="{Binding AddDeviceCommand}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Interval synchronizácie" Margin="0,10,0,0" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="80" VerticalContentAlignment="Center"
                         Text="{Binding SyncIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="s" VerticalAlignment="Center" Margin="6,0,0,0" />
                <Button Content="Uložiť" Padding="12,4" Margin="16,0,0,0" Command="{Binding SaveSyncIntervalCommand}" />
                <TextBlock Text="{Binding SyncIntervalHint}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray" />
            </StackPanel>
        </GroupBox>

        <StatusBar Grid.Row="4" Margin="0,10,0,0">
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>
    </Grid>
</Window>
