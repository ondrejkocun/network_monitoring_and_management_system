<Window x:Class="NetworkMonitoringSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NetworkMonitoringSystem.Desktop.ViewModels"
        xmlns:controls="clr-namespace:NetworkMonitoringSystem.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Title="{Binding Title}" Height="860" Width="1100" MinHeight="620" MinWidth="860">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameDeviceCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <controls:UsageBrushConverter x:Key="UsageBrush" />
        <Style x:Key="Gauge" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="#ECEFF1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource UsageBrush}}" />
        </Style>

        <!-- One look for every list: read-only, row lines only, no frame inside a tab. -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- The application: who is signed in and what concerns the whole system. -->
        <Border DockPanel.Dock="Top" Background="#F3F5F8" BorderBrush="#D9DEE5" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Odhlásiť" Margin="8,0,0,0" Command="{Binding LogoutCommand}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentUserText}" Style="{StaticResource Hint}" Margin="16,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Zmeniť heslo" Margin="8,0,0,0" Click="OnChangePasswordClick" />
                <Button DockPanel.Dock="Right" Content="Používatelia a roly" Margin="8,0,0,0" Click="OnAccessClick"
                        Visibility="{Binding CanManageUsers, Converter={StaticResource VisibleWhenTrue}}" />
                <Button DockPanel.Dock="Right" Content="Nastavenia sledovania…" Margin="8,0,0,0" Click="OnSettingsClick"
                        Visibility="{Binding CanManageSettings, Converter={StaticResource VisibleWhenTrue}}" />
                <Button DockPanel.Dock="Right" Content="Záznam udalostí" Margin="8,0,0,0" Click="OnEventLogClick"
                        Visibility="{Binding CanViewEventLog, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock Text="Network Monitoring &amp; Management System" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding LastRefreshText}" Foreground="Gray" Margin="12,0,4,0" />
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <!-- Hard to miss: without the server everything shown is getting old. -->
        <Border DockPanel.Dock="Top" Background="#C62828" Padding="12,6"
                Visibility="{Binding IsServerUnavailable, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding ConnectionWarningText}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top" Background="#FFF3E0" BorderBrush="#E65100" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding HasAlert, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Beriem na vedomie" Margin="12,0,0,0" Command="{Binding DismissAlertsCommand}" />
                <TextBlock Text="⚠" Foreground="#E65100" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding AlertText}" Foreground="#BF360C" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Margin="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="260" />
            </Grid.RowDefinitions>

            <!-- Devices -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Obnoviť" ToolTip="F5" Command="{Binding RefreshCommand}" />
                <Button DockPanel.Dock="Right" Content="+ Pridať zariadenie…" Margin="0,0,8,0" Click="OnAddDeviceClick"
                        ToolTip="Pridá zariadenie bez agenta, napríklad router alebo switch."
                        Visibility="{Binding CanAddDevices, Converter={StaticResource VisibleWhenTrue}}" />
                <ComboBox DockPanel.Dock="Right" Width="100" Margin="0,0,16,0" ItemsSource="{Binding DeviceStatusFilters}"
                          SelectedItem="{Binding DeviceStatusFilter}" AutomationProperties.Name="Stav zariadení" ToolTip="Zobraziť len zariadenia v tomto stave." />
                <TextBox x:Name="DeviceSearchBox" DockPanel.Dock="Right" Width="200" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Hľadať zariadenie" ToolTip="Názov, adresa alebo operačný systém (Ctrl+F)."
                         Text="{Binding DeviceFilterText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock DockPanel.Dock="Right" Text="Hľadať:" Style="{StaticResource Hint}" Margin="0,0,6,0" />
                <TextBlock Text="Zariadenia" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding DevicesSummaryText}" Style="{StaticResource Hint}" Margin="12,2,0,0" />
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" SelectionMode="Single">
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveDeviceCommand}" />
                    <KeyBinding Key="F2" Command="{Binding RenameDeviceCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Premenovať…" InputGestureText="F2" Command="{Binding RenameDeviceCommand}" />
                        <MenuItem Header="{Binding ToggleDeviceEnabledText}" Command="{Binding ToggleDeviceEnabledCommand}" />
                        <MenuItem Header="{Binding ToggleTrafficCaptureText}" Command="{Binding ToggleTrafficCaptureCommand}" />
                        <MenuItem Header="Poslať _súbor…" Command="{Binding SendFileCommand}" />
                        <Separator />
                        <MenuItem Header="_Odstrániť" InputGestureText="Del" Command="{Binding RemoveDeviceCommand}" />
                        <Separator />
                        <MenuItem Header="O_bnoviť zoznam" InputGestureText="F5" Command="{Binding RefreshCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusText}" Value="Offline" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#FDECEA" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Foreground" Value="Gray" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Adresa" Binding="{Binding Address}" Width="2*" />
                    <DataGridTextColumn Header="Sledovanie" Binding="{Binding ModeText}" Width="*" />
                    <DataGridTextColumn Header="Stav" Binding="{Binding StatusText}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="Gray" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="Online">
                                        <Setter Property="Foreground" Value="#1B7F3B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusText}" Value="Offline">
                                        <Setter Property="Foreground" Value="#C62828" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Naposledy videné" Binding="{Binding LastSeenText}" Width="2*" />
                    <DataGridTextColumn Header="Operačný systém" Binding="{Binding OperatingSystem}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- The user decides how much room the list and the details get. -->
            <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                          ToolTip="Potiahnutím zmeníte veľkosť zoznamu a detailu." />

            <!-- The selected device -->
            <DockPanel Grid.Row="3">
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasSelectedDevice, Converter={StaticResource VisibleWhenTrue}}">
                        <Label Content="_Obdobie:" Target="{Binding ElementName=PeriodBox}" Padding="0,0,6,0" VerticalAlignment="Center"
                               ToolTip="Obdobie pre históriu aktivity, komunikáciu, grafy, výpadky a udalosti." />
                        <ComboBox x:Name="PeriodBox" Width="150" Margin="0,0,16,0" ItemsSource="{Binding HistoryPeriods}"
                                  DisplayMemberPath="Label" SelectedItem="{Binding SelectedHistoryPeriod}" />
                        <Button Content="Premenovať" ToolTip="F2" Margin="0,0,8,0" Command="{Binding RenameDeviceCommand}" />
                        <Button Content="{Binding ToggleDeviceEnabledText}" Margin="0,0,8,0" Command="{Binding ToggleDeviceEnabledCommand}" />
                        <Button Content="Odstrániť" ToolTip="Delete v zozname zariadení" Command="{Binding RemoveDeviceCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedDeviceHeaderText}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Grid>
                <TabControl Visibility="{Binding HasSelectedDevice, Converter={StaticResource VisibleWhenTrue}}">
                    <TabItem Header="Prehľad">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding ResourcesMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResourcesMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel DataContext="{Binding SelectedDeviceResources}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="320" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" MaxWidth="320" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" />
                                            <TextBlock Text="Procesor" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource Gauge}" Value="{Binding CpuPercent, Mode=OneWay}" AutomationProperties.Name="Využitie procesora" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" />
                                            <TextBlock Text="Pamäť" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource Gauge}" Value="{Binding MemoryPercent, Mode=OneWay}" AutomationProperties.Name="Využitie pamäte" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                        <TextBlock Text="Namerané" Foreground="Gray" />
                                        <TextBlock Text="{Binding RecordedAtText}" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="5*" />
                                    </Grid.ColumnDefinitions>

                                    <DataGrid Grid.Column="0" ItemsSource="{Binding Disks}" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Disk" Binding="{Binding Name}" Width="Auto" />
                                            <DataGridTemplateColumn Header="Obsadené" Width="*" SortMemberPath="UsagePercent">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2" ToolTip="{Binding UsageText}">
                                                            <ProgressBar Style="{StaticResource Gauge}" Height="18" Value="{Binding UsagePercent, Mode=OneWay}" />
                                                            <TextBlock Text="{Binding UsageText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Voľné" Binding="{Binding FreeText}" Width="Auto" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <DataGrid Grid.Column="2" ItemsSource="{Binding NetworkInterfaces}" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Sieťové rozhranie" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="IP adresa" Binding="{Binding IpAddress}" Width="Auto" />
                                            <DataGridTextColumn Header="MAC adresa" Binding="{Binding MacAddress}" Width="Auto" />
                                            <DataGridTextColumn Header="Stav" Binding="{Binding StateText}" Width="Auto" />
                                            <DataGridTextColumn Header="Odoslané" Binding="{Binding SentText}" Width="Auto" />
                                            <DataGridTextColumn Header="Prijaté" Binding="{Binding ReceivedText}" Width="Auto" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Aktivita">
                        <TabControl Margin="6" TabStripPlacement="Top">
                            <TabItem Header="{Binding SelectedDeviceActivity.ProcessesHeader, FallbackValue=Procesy}">
                                <DataGrid ItemsSource="{Binding SelectedDeviceActivity.Processes}" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Proces" Binding="{Binding Name}" Width="3*" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="*" />
                                        <DataGridTextColumn Header="Procesor" Binding="{Binding CpuText}" Width="*" />
                                        <DataGridTextColumn Header="Pamäť" Binding="{Binding MemoryText}" Width="*" />
                                        <DataGridTextColumn Header="Spustený" Binding="{Binding StartedText}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="{Binding SelectedDeviceActivity.ListeningPortsHeader, FallbackValue=Otvorené porty}">
                                <DataGrid ItemsSource="{Binding SelectedDeviceActivity.ListeningPorts}" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="*" />
                                        <DataGridTextColumn Header="Protokol" Binding="{Binding Protocol}" Width="*" />
                                        <DataGridTextColumn Header="Adresa" Binding="{Binding LocalAddress}" Width="2*" />
                                        <DataGridTextColumn Header="Proces" Binding="{Binding ProcessText}" Width="3*" />
                                        <DataGridTextColumn Header="Otvorený od" Binding="{Binding OpenedText}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="{Binding SelectedDeviceActivity.ConnectionsHeader, FallbackValue=Spojenia}">
                                <DataGrid ItemsSource="{Binding SelectedDeviceActivity.Connections}" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Proces" Binding="{Binding ProcessText}" Width="3*" />
                                        <DataGridTextColumn Header="Protokol" Binding="{Binding Protocol}" Width="*" />
                                        <DataGridTextColumn Header="Miestna adresa" Binding="{Binding LocalEndpoint}" Width="3*" />
                                        <DataGridTextColumn Header="Vzdialená adresa" Binding="{Binding RemoteEndpoint}" Width="3*" />
                                        <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="História za obdobie">
                                <DockPanel Margin="6">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Label Content="_Filter:" Target="{Binding ElementName=ActivityHistoryFilterBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="ActivityHistoryFilterBox" Width="220" VerticalContentAlignment="Center"
                                                 ToolTip="Názov procesu, presné číslo PID alebo portu, protokol alebo adresa."
                                                 Text="{Binding SelectedDeviceActivityHistory.FilterText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedDeviceActivityHistory.SummaryText}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SelectedDeviceActivityHistory.PortsHeader, FallbackValue=Porty otvorené v období}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding SelectedDeviceActivityHistory.Ports}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="*" />
                                                <DataGridTextColumn Header="Protokol" Binding="{Binding Protocol}" Width="*" />
                                                <DataGridTextColumn Header="Adresa" Binding="{Binding LocalAddress}" Width="2*" />
                                                <DataGridTextColumn Header="Proces" Binding="{Binding ProcessText}" Width="3*" />
                                                <DataGridTextColumn Header="Otvorený" Binding="{Binding OpenedText}" Width="2*" />
                                                <DataGridTextColumn Header="Zatvorený" Binding="{Binding ClosedText}" Width="2*" />
                                                <DataGridTextColumn Header="Trvanie" Binding="{Binding DurationText}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedDeviceActivityHistory.ProcessesHeader, FallbackValue=Procesy bežiace v období}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <DataGrid Grid.Row="1" Grid.Column="2" ItemsSource="{Binding SelectedDeviceActivityHistory.Processes}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Proces" Binding="{Binding Name}" Width="3*" />
                                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="*" />
                                                <DataGridTextColumn Header="Spustený" Binding="{Binding StartedText}" Width="2*" />
                                                <DataGridTextColumn Header="Skončil" Binding="{Binding EndedText}" Width="2*" />
                                                <DataGridTextColumn Header="Trvanie" Binding="{Binding DurationText}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </TabItem>

                    <TabItem Header="{Binding SelectedDeviceTraffic.Header, FallbackValue=Komunikácia}">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="{Binding ToggleTrafficCaptureText}"
                                        Command="{Binding ToggleTrafficCaptureCommand}"
                                        Visibility="{Binding SelectedDevice.CanManage, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                                <TextBlock Text="{Binding TrafficCaptureStatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Zobraziť všetko" Margin="8,0,0,0"
                                        Command="{Binding ShowAllTrafficCommand}"
                                        ToolTip="Znova zobrazí komunikáciu za celé zvolené obdobie." />
                                <Button DockPanel.Dock="Right" Content="Vynulovať" Margin="8,0,0,0"
                                        Command="{Binding ResetTrafficCommand}"
                                        ToolTip="Vyprázdni tabuľku; potom ukazuje len komunikáciu, ktorá príde po tomto okamihu." />
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="_Filter:" Target="{Binding ElementName=TrafficFilterBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="TrafficFilterBox" Width="200" VerticalContentAlignment="Center"
                                             Text="{Binding SelectedDeviceTraffic.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Adresa, protokol (napr. TLS, DNS) alebo presné číslo portu." />
                                    <Label Content="_Transport:" Target="{Binding ElementName=TrafficTransportBox}" Padding="0,0,6,0" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="TrafficTransportBox" Width="90"
                                              ItemsSource="{Binding SelectedDeviceTraffic.TransportOptions}"
                                              SelectedItem="{Binding SelectedDeviceTraffic.SelectedTransport}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding TrafficSinceText}" Foreground="#1565C0" Margin="0,0,0,6"
                                       Visibility="{Binding IsTrafficReset, Converter={StaticResource VisibleWhenTrue}}" />
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedDeviceTraffic.TotalText}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                            <DataGrid ItemsSource="{Binding SelectedDeviceTraffic.Rows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vzdialená adresa" Binding="{Binding RemoteAddress}" Width="3*" />
                                    <DataGridTextColumn Header="Port" Binding="{Binding PortText}" Width="*" />
                                    <DataGridTextColumn Header="Protokol" Binding="{Binding Protocol}" Width="2*" />
                                    <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="*" />
                                    <DataGridTextColumn Header="Odoslané" Binding="{Binding SentText}" Width="2*" />
                                    <DataGridTextColumn Header="Prijaté" Binding="{Binding ReceivedText}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="História">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="100" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Sieťová prevádzka" FontWeight="SemiBold" Margin="0,0,12,0" />
                                <TextBlock Text="■ odoslané" Foreground="#1565C0" Margin="0,0,8,0" />
                                <TextBlock Text="■ prijaté" Foreground="#2E7D32" />
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Odozva na ping zo servera" FontWeight="SemiBold" />

                            <controls:LineChart Grid.Row="1" Grid.Column="0" Stroke="#1565C0" SecondStroke="#2E7D32"
                                                Points="{Binding SelectedDeviceHistory.SentPoints}"
                                                SecondPoints="{Binding SelectedDeviceHistory.ReceivedPoints}"
                                                GridLabels="{Binding SelectedDeviceHistory.TrafficLabels}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SelectedDeviceHistory.TrafficChartMessage}"
                                       Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                            <controls:LineChart Grid.Row="1" Grid.Column="2" Stroke="#6A1B9A"
                                                Points="{Binding SelectedDeviceHistory.ResponsePoints}"
                                                GridLabels="{Binding SelectedDeviceHistory.ResponseLabels}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedDeviceHistory.ResponseChartMessage}"
                                       Style="{StaticResource Hint}" HorizontalAlignment="Center" />

                            <DockPanel Grid.Row="2" Grid.Column="0" Margin="64,0,4,8">
                                <TextBlock DockPanel.Dock="Right" Foreground="Gray" FontSize="11" Text="{Binding SelectedDeviceHistory.PeriodEndText}" />
                                <TextBlock Foreground="Gray" FontSize="11" Text="{Binding SelectedDeviceHistory.PeriodStartText}" />
                            </DockPanel>
                            <DockPanel Grid.Row="2" Grid.Column="2" Margin="64,0,4,8">
                                <TextBlock DockPanel.Dock="Right" Foreground="Gray" FontSize="11" Text="{Binding SelectedDeviceHistory.PeriodEndText}" />
                                <TextBlock Foreground="Gray" FontSize="11" Text="{Binding SelectedDeviceHistory.PeriodStartText}" />
                            </DockPanel>

                            <TabControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                <TabItem Header="{Binding SelectedDeviceHistory.OutagesHeader, FallbackValue=Výpadky}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                                            <TextBlock Text="Dostupnosť za obdobie: " FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedDeviceHistory.AvailabilityText, FallbackValue=–}" Margin="0,0,24,0" />
                                            <TextBlock Text="Výpadky spolu: " FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedDeviceHistory.DowntimeText, FallbackValue=–}" />
                                        </StackPanel>
                                        <DataGrid ItemsSource="{Binding SelectedDeviceHistory.Outages}" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Začiatok" Binding="{Binding StartedText}" Width="2*" />
                                                <DataGridTextColumn Header="Koniec" Binding="{Binding EndedText}" Width="2*" />
                                                <DataGridTextColumn Header="Trvanie" Binding="{Binding DurationText}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="{Binding SelectedDeviceHistory.EventsHeader, FallbackValue=Udalosti}">
                                    <DataGrid ItemsSource="{Binding SelectedDeviceHistory.Events}" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Čas" Binding="{Binding OccurredText}" Width="Auto" />
                                            <DataGridTextColumn Header="Udalosť" Binding="{Binding TypeText}" Width="Auto" />
                                            <DataGridTextColumn Header="Závažnosť" Binding="{Binding SeverityText}" Width="Auto" />
                                            <DataGridTextColumn Header="Správa" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding CommandsHeader}">
                        <DockPanel Margin="8">
                            <WrapPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,4" IsEnabled="{Binding CanSendCommands}">
                                    <Label Content="_Príkaz:" Target="{Binding ElementName=CommandBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="CommandBox" Width="210" ItemsSource="{Binding CommandOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,4" IsEnabled="{Binding CanSendCommands}"
                                            Visibility="{Binding IsCommandParameterNeeded, Converter={StaticResource VisibleWhenTrue}}">
                                    <TextBlock Text="{Binding CommandParameterLabel, StringFormat={}{0}:}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Width="200" VerticalContentAlignment="Center" MaxLength="253"
                                             AutomationProperties.Name="{Binding CommandParameterLabel}"
                                             Text="{Binding CommandParameter, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Content="Odoslať príkaz" Margin="0,0,0,4" Command="{Binding SendCommandCommand}" />
                                <Button Content="Poslať súbor…" Margin="12,0,0,4" Command="{Binding SendFileCommand}"
                                        ToolTip="Pošle súbor (najviac 100 MB) do priečinka C:\ProgramData\NetworkMonitoringSystem\Inbox na zariadení. Agent ho nespustí." />
                            </WrapPanel>

                            <TextBlock DockPanel.Dock="Top" Text="{Binding CommandMessage}" Style="{StaticResource Hint}" Margin="0,2,0,6" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <DataGrid Grid.Column="0" ItemsSource="{Binding DeviceCommands}" SelectedItem="{Binding SelectedCommandRow}" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Čas" Binding="{Binding RequestedText}" Width="Auto" />
                                        <DataGridTextColumn Header="Príkaz" Binding="{Binding CommandText}" Width="Auto" />
                                        <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="Auto" />
                                        <DataGridTextColumn Header="Odoslal" Binding="{Binding RequestedBy}" Width="Auto" />
                                        <DataGridTextColumn Header="Stav" Binding="{Binding StatusText}" Width="Auto" />
                                        <DataGridTextColumn Header="Výsledok" Binding="{Binding ResultSummary}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBox Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" AutomationProperties.Name="Výsledok vybraného príkazu"
                                         Text="{Binding SelectedCommandRow.ResultMessage, Mode=OneWay, FallbackValue=Vyberte príkaz a zobrazí sa jeho celý výsledok.}" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <!-- Without a selected device: the whole network at a glance. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding NetworkOverview}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.HasSelectedDevice, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Vyberte zariadenie v zozname a zobrazí sa jeho detail." Style="{StaticResource Hint}" Margin="0,0,0,10" />

                        <UniformGrid Rows="1" Margin="0,0,0,14">
                            <UniformGrid.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#D9DEE5" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="4" />
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="Margin" Value="0,0,10,0" />
                                </Style>
                            </UniformGrid.Resources>
                            <Border Background="#E8F5E9">
                                <StackPanel>
                                    <TextBlock Text="{Binding OnlineCount}" FontSize="26" FontWeight="SemiBold" Foreground="#1B7F3B" />
                                    <TextBlock Text="online" Foreground="Gray" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FDECEA">
                                <StackPanel>
                                    <TextBlock Text="{Binding OfflineCount}" FontSize="26" FontWeight="SemiBold" Foreground="#C62828" />
                                    <TextBlock Text="offline" Foreground="Gray" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisabledCount}" FontSize="26" FontWeight="SemiBold" Foreground="Gray" />
                                    <TextBlock Text="zakázané" Foreground="Gray" />
                                </StackPanel>
                            </Border>
                            <Border Background="#E3F2FD">
                                <StackPanel>
                                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#1565C0">
                                        <Run Text="{Binding AgentCount, Mode=OneWay}" /><Run Text=" / " Foreground="Gray" /><Run Text="{Binding AgentlessCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="s agentom / bez agenta" Foreground="Gray" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding OfflineHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding OfflineDevices}" MaxHeight="200" Margin="0,0,0,14">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OfflineDevices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zariadenie" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Adresa" Binding="{Binding Address}" Width="2*" />
                                <DataGridTextColumn Header="Naposledy videné" Binding="{Binding LastSeenText}" Width="2*" />
                                <DataGridTextColumn Header="Nedostupné" Binding="{Binding OfflineForText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding HasCaptureProblems, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,14">
                            <TextBlock Text="Problémy so zachytávaním komunikácie" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding CaptureProblems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Problem, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding WarningsHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding Warnings}" MaxHeight="260">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Warnings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Čas" Binding="{Binding OccurredText}" Width="Auto" />
                                <DataGridTextColumn Header="Závažnosť" Binding="{Binding SeverityText}" Width="Auto" />
                                <DataGridTextColumn Header="Zariadenie" Binding="{Binding DeviceName}" Width="Auto" />
                                <DataGridTextColumn Header="Správa" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
