<Window x:Class="NetworkMonitoringSystem.Desktop.Views.EventLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NetworkMonitoringSystem.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:EventLogViewModel}"
        Title="Záznam udalostí" Height="620" Width="1000" MinHeight="400" MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Label Content="_Obdobie:" Target="{Binding ElementName=PeriodBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
            <ComboBox x:Name="PeriodBox" Width="160" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" Margin="0,0,16,0" />
            <Label Content="_Závažnosť:" Target="{Binding ElementName=SeverityBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
            <ComboBox x:Name="SeverityBox" Width="110" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}" Margin="0,0,16,0" />
            <Label Content="_Filter:" Target="{Binding ElementName=FilterBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="220" VerticalContentAlignment="Center" Margin="0,0,16,0"
                     ToolTip="Typ udalosti, zariadenie, používateľ alebo text správy."
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Obnoviť" Padding="12,4" Command="{Binding RefreshCommand}" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap" />

        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Čas" Binding="{Binding OccurredText}" Width="140" />
                <DataGridTextColumn Header="Závažnosť" Binding="{Binding SeverityText}" Width="90" />
                <DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="170" />
                <DataGridTextColumn Header="Zariadenie" Binding="{Binding DeviceText}" Width="140" />
                <DataGridTextColumn Header="Používateľ" Binding="{Binding UserText}" Width="110" />
                <DataGridTextColumn Header="Správa" Binding="{Binding Message}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
