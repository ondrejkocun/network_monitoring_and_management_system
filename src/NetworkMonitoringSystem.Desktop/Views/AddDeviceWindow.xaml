<Window x:Class="NetworkMonitoringSystem.Desktop.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NetworkMonitoringSystem.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Title="Pridať zariadenie bez agenta" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Napríklad router alebo switch. Server ho kontroluje pingom, a keď na ping neodpovedá, pripojením na zadaný TCP port."
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12" />

        <Label Content="_Názov" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
        <TextBox x:Name="NameBox" Padding="4" Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="_IP adresa" Target="{Binding ElementName=AddressBox}" Padding="0,10,0,4" />
        <TextBox x:Name="AddressBox" Padding="4" Text="{Binding NewDeviceIpAddress, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="_TCP port (nepovinné)" Target="{Binding ElementName=PortBox}" Padding="0,10,0,4" />
        <TextBox x:Name="PortBox" Padding="4" Width="100" HorizontalAlignment="Left"
                 ToolTip="Ak zariadenie neodpovedá na ping, server sa skúsi pripojiť na tento port."
                 Text="{Binding NewDeviceTcpPort, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding AddDeviceMessage}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Zrušiť" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="Pridať" IsDefault="True" Padding="16,6" Command="{Binding AddDeviceCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
